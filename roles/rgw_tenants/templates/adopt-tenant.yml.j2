---
# Adoption stub for an unmanaged RGW account (generated by rgw_tenants discovery, tasks/discover.yml). This account already
# exists on the cluster but is not in rgw_tenants_list. Discovery is read-only -- nothing on the cluster was changed.
#
# To bring it under management:
#   1. Review and edit the entry below
#      (name/root_user/buckets, add quota/limits/tiers as needed).
{% set slug = acct.slug | default('', true) or (acct.id | lower) %}
#   2. Add the account-root's existing S3 keys to your vault as
#        vault_rgw_tenants_{{ slug }}_access_key
#        vault_rgw_tenants_{{ slug }}_secret_key
#      The role reuses these keys.
#      It does not re-create the root user unless you set rotate_keys: true, which rolls the keys to the vaulted value.
#      Only do that when you intend to rotate.
#   3. Merge this item into rgw_tenants_list and run the rgw_tenants role
#      (state defaults to present).
#
# The account boundary already isolates this tenant. Provisioning it only reconciles the OIDC
# provider, per-tier roles, and buckets to match config.
{% if not acct.slug %}
# WARNING: could not derive the tenant slug from role/bucket prefixes (they disagree or are absent). "{{ slug }}" below is
# a placeholder from the account id. Set `name` to the real tenant slug (the common prefix of the roles/buckets) before
# adopting.
{% endif %}
- name: {{ slug }}   # account name on cluster: {{ acct.name | default('(unnamed)', true) }}
  account_id: "{{ acct.id }}"
{% if acct.root_user %}
  root_user: {{ acct.root_user }}   # discovered account user(s): {{ acct.users | join(', ') }}
{% endif %}
{% if acct.buckets | length > 0 %}
  buckets:
{% for b in acct.buckets %}
    - {{ b }}
{% endfor %}
{% else %}
  buckets: []
{% endif %}
  # quota: {}      # optional {enabled, max_size(bytes/-1), max_objects(count/-1)}
  # limits: {}     # optional {max_users, max_buckets} (-1 = unlimited)
  # discovered IAM roles: {{ acct.roles | join(', ') if acct.roles else '(none)' }}
