{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": ["arn:aws:iam::{{ item.tenant.account_id }}:oidc-provider/{{ _rgw_tenants_provider_host }}"]
      },
      "Action": ["sts:AssumeRoleWithWebIdentity"],
      "Condition": {
        "StringEquals": {
          "{{ _rgw_tenants_provider_host }}:org": "{{ item.tenant.name }}",
          "{{ _rgw_tenants_provider_host }}:tier": "{{ item.tier.name }}"
        }
      }
    }
  ]
}
