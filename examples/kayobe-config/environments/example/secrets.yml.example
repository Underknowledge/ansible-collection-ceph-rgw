---
# Example vault contents.
# In a real deployment these live in your ansible-vault'd environments/<env>/secrets.yml.
# Generate strong random values. Never commit plaintext.
# Every vaulted value is vault_-prefixed (kayobe house style) and role-name-prefixed
# (vault_rgw_sts_* / vault_rgw_tenants_*) so it sits next to the rest of your ceph secrets.
#
# Signing key for RGW STS (any non-empty string, 16+ random chars recommended):
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 16
vault_rgw_sts_key: "REPLACE-ME-16-CHARS"

# Per-tenant account-root S3 keys.
# The role looks up vault_rgw_tenants_<name>_access_key / _secret_key by name for every tenant in rgw_tenants_list
# (and asserts they are defined before provisioning).
#   access key: tr -dc 'A-Z0-9' </dev/urandom | head -c 20
#   secret key: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40
vault_rgw_tenants_acme_access_key: "REPLACE-ME-20-CHARS"
vault_rgw_tenants_acme_secret_key: "REPLACE-ME-40-CHARS"
vault_rgw_tenants_globex_access_key: "REPLACE-ME-20-CHARS"
vault_rgw_tenants_globex_secret_key: "REPLACE-ME-40-CHARS"
